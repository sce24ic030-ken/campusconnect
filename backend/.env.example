# =========================================================
# CAMPUSCONNECT ENVIRONMENT VARIABLES (example)
# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file.
# =========================================================

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campusconnect

# Managed MySQL (Aiven, etc.):
#   DB_HOST / DB_PORT / DB_USER / DB_PASSWORD come from the provider.
#   Aiven requires TLS, so set DB_SSL=true.
#   DB_SSL_CA is optional: a path to the provider's ca.pem for full
#   certificate verification.
#   DB_SKIP_CREATE=true stops the app from running CREATE DATABASE.
DB_SSL=
DB_SSL_CA=
DB_SKIP_CREATE=

# ---- Flask ----
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-long-random-secret-value

# ---- JWT ----
JWT_SECRET=change-this-to-a-long-random-jwt-secret-value
JWT_EXPIRY_HOURS=24

# ---- CORS ----
# Comma-separated list of allowed origins, or * for any (default).
CORS_ORIGINS=*

# ---- Chatbot (NVIDIA NIM / GPT-OSS) ----
# SECRET: never commit the real key. Get one at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key
CHATBOT_BASE_URL=https://integrate.api.nvidia.com/v1
CHATBOT_MODEL=openai/gpt-oss-20b
CHATBOT_MAX_TOKENS=1024
CHATBOT_TEMPERATURE=0.6
CHATBOT_TIMEOUT=30
CHATBOT_REASONING_EFFORT=low

# ---- Voice input / speech-to-text (NVIDIA hosted speech NIM) ----
# Runs server-side (gRPC) so the mic works in every browser.
# Reuses NVIDIA_API_KEY above; no extra key needed.
ASR_ENABLED=true
ASR_SERVER=grpc.nvcf.nvidia.com:443
ASR_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
# ASR_MODEL is optional; leave blank so the function-id picks the model.
ASR_MODEL=
ASR_LANGUAGE=en
ASR_TIMEOUT=45
ASR_MAX_BYTES=8388608
